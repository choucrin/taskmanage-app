# Firebaseプロジェクトのコンソール(プロジェクト設定 > 全般 > マイアプリ)から取得した値をコピーしてください。
# このファイルをコピーして .env.local を作成し、値を埋めてください(.env.local はコミットしないこと)。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging の Web Push証明書(VAPIDキー)
# コンソール > プロジェクト設定 > Cloud Messaging > ウェブ構成 で生成
VITE_FIREBASE_VAPID_KEY=
