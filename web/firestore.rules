rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid} 配下の全データは、認証済み本人(uid一致)のみ読み書き可能とする。
    // fcmToken等のユーザードキュメント自体、および配下の全サブコレクション(genres, goals,
    // tasks, selectiveGroups, progressLogs, notificationSettings)に一括で適用される。
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // 上記以外のパスは一切アクセス不可(デフォルト拒否)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
